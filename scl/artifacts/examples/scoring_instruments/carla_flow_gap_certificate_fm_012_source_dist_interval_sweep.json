 "method": {
  "crossing_region": "union of the ego's oriented body polygons from zone entry to exit on the reference clean crossing, clipped to the declared lane polygon",
  "commitment": "the ego's first frame whose body intersects the declared lane polygon (zone_contact); every crossing reading of a run stops there (an arrival at or before it, an occupancy whose car left the region before it, a pair-gap frame at or before it) and a run whose ego never entered is read whole (2026-10-19; the per-run spawn cadence has stopped there since F96); every run of a cell counts",
  "local_headway": "front-to-front time between consecutive scenario cars' first intersection with the crossing region, both at or before the commitment; occupancy = a car's first to last intersection, counted when the last precedes the commitment",
  "usable_window": "median local headway minus median occupancy over every run of the cell, each read up to its ego's commitment (a run that never entered read whole); the pair gap when no local headway could be measured (the recording ended, or the ego committed, before a second car arrived); the spawn-interval headway when neither could (a platoon, or no car in the crossing before any ego committed); a registered cell takes the spawn cadence, its flow never having formed; headway_source names the one in use; a cell where no car left the crossing before an ego committed has no occupancy, no window and the band unmeasured",
  "pair_gap": "for each car in the crossing region and the car spawned after it, wherever that car is: at every frame the first is inside and the second exists and moves (above 0.5 m/s), the distance between them over the second car's speed at that frame, averaged over those frames at or before the commitment; a prediction of the arrival headway from the present state (2026-10-19; within 0.25 s of the arrival headway on every cell of both families where both could be read)",
  "headway_at_crossing": "the variant's axis (F96): median over its seeds of the seed's local headway; the seed values beside it (headway_by_seed_s); null when no seed measured one",
  "spawn_headway": "median consecutive spawn interval over the cars spawned at or before the ego's first entry into the lane (the whole run when it never entered; null when fewer than two had spawned), flow_aggregate.measure_flow_data",
  "standstill": "the last stretch of >= 0.5 s below 0.2 m/s ending before the zone entry, within 20.0 m of path of it",
  "acceleration": "max speed change over 0.5 s windows after the first 1.0 s, p50 across runs",
  "floor_from_rest": "time to cover the p10 standstill-to-exit distance from rest at the measured acceleration, capped at the speed limit",
  "rolling_reference": "crossing path length (median of crossing duration x entry speed over clean rolling crossings) over the median entry speed of those crossings",
  "bands": "usable: window >= floor_from_rest + margin; conditional: window >= rolling_reference + margin; else wait; a variant takes the band its measured seeds agree on and is mixed when they disagree; unmeasured when no seed measured a window, defect when every seed is registered",
  "platoon": "a seed whose spawn-interval headway is no longer than a car's occupancy of the crossing has no window between cars (nose to tail); its window is spawn headway minus occupancy, never the per-car arrival measurement, hence wait"
 },
